{
  "name": "small-hours-taskboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.5.1",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "test:feature": "playwright test --config playwright.feature.config.ts",
    "verify": "npm run typecheck && npm run build && npm run test:coverage && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
